# Copy to .env and fill in. Never commit .env.

# --- Deployment mode (source-rights gate) ---
# LOCAL_DEMO | PRIVATE_PERSONAL | PUBLIC_NONCOMMERCIAL | PUBLIC_COMMERCIAL
FGX_DEPLOYMENT_MODE=PRIVATE_PERSONAL

# --- LLM (OpenRouter) ---
# Used by the Morning Brief (CI) AND the dashboard AI chat widget. For the chat
# widget the key must ALSO be set on the Cloudflare Pages project (Settings ->
# Variables and Secrets -> Production) because the chat proxy runs there as a Pages
# Function (functions/api/chat.js) — never in the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Chat web search: OpenRouter runs it via the ":online" model suffix. Set to "off"
# on the Cloudflare Pages project to disable web search (and its per-query cost).
# OPENROUTER_WEB_SEARCH=off

# --- Data sources ---
# US Treasury Daily Par Yield Curve + NY Fed Markets API need NO key.
# (FRED was removed for compliance — do not re-add FRED_API_KEY.)

# --- Delivery (Telegram) ---
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # your chat/user id

# --- Firestore archive (CI only; uses Workload Identity Federation, no key file) ---
# Set by the CI GCP-auth job via WIF/ADC. Locally these stay empty.
GOOGLE_CLOUD_PROJECT=            # GCP/Firebase project id
# FGX_FIRESTORE_COLLECTION=snapshots_history
# The following are GitHub Actions secrets/vars, NOT used by local runs:
#   WIF_PROVIDER              full resource name of the OIDC provider
#   WIF_WRITER_SA             writer service-account email (Firestore create)
#   WIF_READER_SA             reader service-account email (read-only)

# --- Cloudflare Pages (CI only) ---
#   CLOUDFLARE_API_TOKEN      Pages:Edit scoped token
#   CLOUDFLARE_ACCOUNT_ID     account id

# --- Cloudflare Access service token (CI smoke test only) ---
#   CF_ACCESS_CLIENT_ID       Access service-token client id
#   CF_ACCESS_CLIENT_SECRET   Access service-token client secret

# --- Optional overrides ---
# FGX_DB_PATH=data/forwardguidex.duckdb
# FGX_PRICE_PERIOD=1y
